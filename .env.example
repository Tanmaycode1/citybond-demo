# Run npm run setup:local to generate real local credentials.
# Keep secrets server-side; do not use NEXT_PUBLIC_ prefixes.
CMS_PASSWORD_HASH=
CMS_SESSION_SECRET=

# Hosting: connect a private Vercel Blob store to the Vercel project.
# Vercel supplies BLOB_STORE_ID; authentication uses deployment OIDC.
# Leave unset during local development to use .data/ on disk.
# BLOB_STORE_ID=

# Optional canonical origin for a deployment of your own.
# SITE_URL=https://citybond.in
