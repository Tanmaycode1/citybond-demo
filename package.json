  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@meta-sam/parser": "^0.1.0",
    "@vercel/blob": "^2.8.2",
    "next": "^16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "amphtml-validator": "^1.0.38",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
